[Unit]
Description=OTelPlane local development service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/OTelPlane
Environment=OTELPLANE_HTTP_ADDR=127.0.0.1:8080
Environment=OTELPLANE_OPAMP_ADDR=127.0.0.1:4320
Environment=OTELPLANE_DATA_DIR=%h/OTelPlane/data
Environment=OTELPLANE_DATABASE_PATH=%h/OTelPlane/data/otelplane.db
Environment=OTELPLANE_TLS_DIR=%h/.config/otelplane/tls
Environment=OTELPLANE_RETIRE_AFTER=24h
Environment=OTELPLANE_LOG_LEVEL=info
Environment=OTELPLANE_LOG_FORMAT=json
Environment=OTELPLANE_LOG_FILE=%h/.local/state/otelplane/log/otelplane.log
EnvironmentFile=-%h/.config/otelplane/otelplane.env
LoadCredentialEncrypted=otelplane-server-pepper:%h/.config/otelplane/credentials/otelplane-server-pepper.cred
ExecStart=%h/.local/bin/otelplane
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=default.target
