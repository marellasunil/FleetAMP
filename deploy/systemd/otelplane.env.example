# Secure defaults listen only on the local host. For remote access, bind to a
# private interface and configure authentication plus TLS at the reverse proxy.
OTELPLANE_HTTP_ADDR=127.0.0.1:8080
OTELPLANE_OPAMP_ADDR=127.0.0.1:4320

# The first administrator is created at /setup with a one-time token. OTelPlane
# stores an Argon2id verifier, never the password. The server pepper is supplied
# as the otelplane-server-pepper encrypted systemd credential, not in this file.
# Set this to true whenever users access OTelPlane over HTTPS.
# OTELPLANE_SECURE_COOKIES=true

# Native TLS uses server.crt and server.key from OTELPLANE_TLS_DIR by default.
# User install: ~/.config/otelplane/tls; system install: /etc/otelplane/tls.
# Store the private key outside Git with mode 0600.
# OTELPLANE_TLS_DIR=/custom/customer/certificate/directory
# OTELPLANE_HTTP_TLS_ENABLED=true
# Optional individual overrides:
# OTELPLANE_HTTP_TLS_CERT_FILE=/custom/path/web.crt
# OTELPLANE_HTTP_TLS_KEY_FILE=/custom/path/web.key

# Use this instead of native HTTP TLS only when a trusted reverse proxy or load
# balancer terminates HTTPS before forwarding to a private OTelPlane listener.
# OTELPLANE_HTTP_TLS_TERMINATED=true

# Environment Basic Auth remains only as a temporary migration fallback.
# OTELPLANE_AUTH_USERNAME=otelplane-operator
# OTELPLANE_AUTH_PASSWORD=replace-with-at-least-16-characters

# Required when OpAMP is exposed beyond localhost. Keep bearer authentication
# enabled even when TLS or mutual TLS is used.
# OTELPLANE_OPAMP_TOKEN=replace-with-at-least-32-random-characters
# OTELPLANE_OPAMP_TLS_ENABLED=true
# By default OpAMP reuses server.crt and server.key from OTELPLANE_TLS_DIR.
# OTELPLANE_OPAMP_TLS_CERT_FILE=/custom/path/opamp.crt
# OTELPLANE_OPAMP_TLS_KEY_FILE=/custom/path/opamp.key
# Optional mTLS uses agent-ca.crt from OTELPLANE_TLS_DIR by default.
# OTELPLANE_OPAMP_TLS_CLIENT_CA_FILE=/custom/path/agent-ca.crt
# OTELPLANE_OPAMP_TLS_REQUIRE_CLIENT_CERT=true
# Use only when a trusted proxy terminates OpAMP TLS.
# OTELPLANE_OPAMP_TLS_TERMINATED=true

# Browser origins allowed to perform state-changing requests.
# OTELPLANE_ALLOWED_ORIGINS=https://otelplane.example.com

# Maximum body accepted by mutating HTTP requests (default 1 MiB).
OTELPLANE_MAX_REQUEST_BODY_BYTES=1048576

# Development escape hatch. Never enable on an untrusted network.
# OTELPLANE_ALLOW_INSECURE=false

# Persistent runtime state.
OTELPLANE_DATA_DIR=/var/lib/otelplane
OTELPLANE_DATABASE_PATH=/var/lib/otelplane/otelplane.db

# Disconnected-agent retirement policy.
OTELPLANE_RETIRE_AFTER=24h

# Optional GitOps execution worker. All providers use dry-run adapters by
# default. Real GitHub pull-request delivery requires the separate write flag;
# GitLab and Azure DevOps remain validation/dry-run only in v0.3.
# OTELPLANE_GITOPS_WORKER_ENABLED=true
# OTELPLANE_GITOPS_WORKER_ID=otelplane-worker-1
# OTELPLANE_GITOPS_WORKER_INTERVAL=5s
# Keep GitHub writes disabled until the repository connection, approval flow,
# and fine-grained token permissions have been verified.
# OTELPLANE_GITOPS_GITHUB_WRITES_ENABLED=false
# Status synchronization is also opt-in and requires GitHub writes/configuration.
# OTELPLANE_GITOPS_GITHUB_STATUS_SYNC_ENABLED=false
# OTELPLANE_GITOPS_STATUS_SYNC_ID=otelplane-worker-1-status
# OTELPLANE_GITOPS_STATUS_SYNC_INTERVAL=30s
# OTELPLANE_GITOPS_HTTP_TIMEOUT=30s
# OTELPLANE_INTEGRATION_HTTP_TIMEOUT=15s
# OTELPLANE_INTEGRATION_VALIDATION_TTL=24h
# Comma-separated hostnames for explicitly approved self-hosted Git providers.
# OTELPLANE_INTEGRATION_ALLOWED_HOSTS=github.company.example,gitlab.company.example
# secret://github/production maps to this environment variable:
# OTELPLANE_GITOPS_SECRET_GITHUB_PRODUCTION=<fine-grained-token>
# OTELPLANE_GITOPS_LEASE_TTL=30s

# Optional: enables validation with a real OpenTelemetry Collector binary.
# OTELPLANE_OTELCOL_BINARY=/opt/otelcol-contrib/otelcol-contrib

# Optional approval email notifications. User email addresses are managed in
# OTelPlane under Settings > Users & roles.
# OTELPLANE_SMTP_ADDR=smtp.example.com:587
# OTELPLANE_SMTP_USERNAME=otelplane@example.com
# OTELPLANE_SMTP_PASSWORD=replace-with-a-secret
# OTELPLANE_SMTP_FROM=otelplane@example.com
# OTELPLANE_PUBLIC_URL=https://otelplane.example.com

# Structured application logging.
OTELPLANE_LOG_LEVEL=info
OTELPLANE_LOG_FORMAT=json
OTELPLANE_LOG_FILE=/var/log/otelplane/otelplane.log
