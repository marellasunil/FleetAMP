# Secure defaults listen only on the local host. For remote access, bind to a
# private interface and configure authentication plus TLS at the reverse proxy.
FLEETAMP_HTTP_ADDR=127.0.0.1:8080
FLEETAMP_OPAMP_ADDR=127.0.0.1:4320

# The first administrator is created at /setup with a one-time token. FleetAMP
# stores an Argon2id verifier, never the password. The server pepper is supplied
# as the fleetamp-server-pepper encrypted systemd credential, not in this file.
# Set this to true whenever users access FleetAMP over HTTPS.
# FLEETAMP_SECURE_COOKIES=true

# Native TLS uses server.crt and server.key from FLEETAMP_TLS_DIR by default.
# User install: ~/.config/fleetamp/tls; system install: /etc/fleetamp/tls.
# Store the private key outside Git with mode 0600.
# FLEETAMP_TLS_DIR=/custom/customer/certificate/directory
# FLEETAMP_HTTP_TLS_ENABLED=true
# Optional individual overrides:
# FLEETAMP_HTTP_TLS_CERT_FILE=/custom/path/web.crt
# FLEETAMP_HTTP_TLS_KEY_FILE=/custom/path/web.key

# Use this instead of native HTTP TLS only when a trusted reverse proxy or load
# balancer terminates HTTPS before forwarding to a private FleetAMP listener.
# FLEETAMP_HTTP_TLS_TERMINATED=true

# Environment Basic Auth remains only as a temporary migration fallback.
# FLEETAMP_AUTH_USERNAME=fleetamp-operator
# FLEETAMP_AUTH_PASSWORD=replace-with-at-least-16-characters

# Required when OpAMP is exposed beyond localhost. Keep bearer authentication
# enabled even when TLS or mutual TLS is used.
# FLEETAMP_OPAMP_TOKEN=replace-with-at-least-32-random-characters
# FLEETAMP_OPAMP_TLS_ENABLED=true
# By default OpAMP reuses server.crt and server.key from FLEETAMP_TLS_DIR.
# FLEETAMP_OPAMP_TLS_CERT_FILE=/custom/path/opamp.crt
# FLEETAMP_OPAMP_TLS_KEY_FILE=/custom/path/opamp.key
# Optional mTLS uses agent-ca.crt from FLEETAMP_TLS_DIR by default.
# FLEETAMP_OPAMP_TLS_CLIENT_CA_FILE=/custom/path/agent-ca.crt
# FLEETAMP_OPAMP_TLS_REQUIRE_CLIENT_CERT=true
# Use only when a trusted proxy terminates OpAMP TLS.
# FLEETAMP_OPAMP_TLS_TERMINATED=true

# Browser origins allowed to perform state-changing requests.
# FLEETAMP_ALLOWED_ORIGINS=https://fleetamp.example.com

# Maximum body accepted by mutating HTTP requests (default 1 MiB).
FLEETAMP_MAX_REQUEST_BODY_BYTES=1048576

# Development escape hatch. Never enable on an untrusted network.
# FLEETAMP_ALLOW_INSECURE=false

# Persistent runtime state.
FLEETAMP_DATA_DIR=/var/lib/fleetamp
FLEETAMP_DATABASE_PATH=/var/lib/fleetamp/fleetamp.db

# Disconnected-agent retirement policy.
FLEETAMP_RETIRE_AFTER=24h

# Optional GitOps execution worker. In v0.3 this is deliberately a dry-run
# adapter: it claims approved outbox entries and records evidence, but never
# contacts or writes to GitHub, GitLab, or Azure DevOps.
# FLEETAMP_GITOPS_WORKER_ENABLED=true
# FLEETAMP_GITOPS_WORKER_ID=fleetamp-worker-1
# FLEETAMP_GITOPS_WORKER_INTERVAL=5s
# Keep GitHub writes disabled until the repository connection, approval flow,
# and fine-grained token permissions have been verified.
# FLEETAMP_GITOPS_GITHUB_WRITES_ENABLED=false
# Status synchronization is also opt-in and requires GitHub writes/configuration.
# FLEETAMP_GITOPS_GITHUB_STATUS_SYNC_ENABLED=false
# FLEETAMP_GITOPS_STATUS_SYNC_ID=fleetamp-worker-1-status
# FLEETAMP_GITOPS_STATUS_SYNC_INTERVAL=30s
# FLEETAMP_GITOPS_HTTP_TIMEOUT=30s
# FLEETAMP_INTEGRATION_HTTP_TIMEOUT=15s
# FLEETAMP_INTEGRATION_VALIDATION_TTL=24h
# secret://github/production maps to this environment variable:
# FLEETAMP_GITOPS_SECRET_GITHUB_PRODUCTION=<fine-grained-token>
# FLEETAMP_GITOPS_LEASE_TTL=30s

# Optional: enables validation with a real OpenTelemetry Collector binary.
# FLEETAMP_OTELCOL_BINARY=/opt/otelcol-contrib/otelcol-contrib

# Optional approval email notifications. User email addresses are managed in
# FleetAMP under Settings > Users & roles.
# FLEETAMP_SMTP_ADDR=smtp.example.com:587
# FLEETAMP_SMTP_USERNAME=fleetamp@example.com
# FLEETAMP_SMTP_PASSWORD=replace-with-a-secret
# FLEETAMP_SMTP_FROM=fleetamp@example.com
# FLEETAMP_PUBLIC_URL=https://fleetamp.example.com

# Structured application logging.
FLEETAMP_LOG_LEVEL=info
FLEETAMP_LOG_FORMAT=json
FLEETAMP_LOG_FILE=/var/log/fleetamp/fleetamp.log
